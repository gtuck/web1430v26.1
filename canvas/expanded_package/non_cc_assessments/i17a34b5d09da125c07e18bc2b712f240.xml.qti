<?xml version='1.0' encoding='utf-8'?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2p1.xsd"><assessment ident="i17a34b5d09da125c07e18bc2b712f240" title="Quiz 6 – Storage and State"><qtimetadata><qtimetadatafield><fieldlabel>cc_maxattempts</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield></qtimetadata><section ident="root_section"><item ident="ibb8af02744c8740f9b13c12714b589ac" title="localStorage"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>localstorage_a1,localstorage_a2,localstorage_a3,localstorage_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;localStorage is best used for:&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="localstorage_a1"><material><mattext texttype="text/html">&lt;p&gt;Data that must be shared across different origins&lt;/p&gt;</mattext></material></response_label><response_label ident="localstorage_a2"><material><mattext texttype="text/html">&lt;p&gt;Small client-side preferences or saved interface state&lt;/p&gt;</mattext></material></response_label><response_label ident="localstorage_a3"><material><mattext texttype="text/html">&lt;p&gt;Session tokens and passwords&lt;/p&gt;</mattext></material></response_label><response_label ident="localstorage_a4"><material><mattext texttype="text/html">&lt;p&gt;Datasets of several hundred megabytes&lt;/p&gt;</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" /></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">localstorage_a2</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="id4cdfb67f89659f5eddb0b96903826ee" title="Persistence"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>true_false_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>persistence_true,persistence_false</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Data in localStorage usually remains after the browser tab is closed.&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="persistence_true"><material><mattext texttype="text/html">&lt;p&gt;True&lt;/p&gt;</mattext></material></response_label><response_label ident="persistence_false"><material><mattext texttype="text/html">&lt;p&gt;False&lt;/p&gt;</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" /></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">persistence_true</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="i3a73dab6e60871c4f110b239e84f5fb0" title="sessionStorage"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>sessionstorage_a1,sessionstorage_a2,sessionstorage_a3,sessionstorage_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;sessionStorage differs from localStorage because it is usually scoped to:&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="sessionstorage_a1"><material><mattext texttype="text/html">&lt;p&gt;The browser profile, until it is manually cleared&lt;/p&gt;</mattext></material></response_label><response_label ident="sessionstorage_a2"><material><mattext texttype="text/html">&lt;p&gt;The current page only, cleared on any navigation&lt;/p&gt;</mattext></material></response_label><response_label ident="sessionstorage_a3"><material><mattext texttype="text/html">&lt;p&gt;The current tab&amp;#x27;s session&lt;/p&gt;</mattext></material></response_label><response_label ident="sessionstorage_a4"><material><mattext texttype="text/html">&lt;p&gt;Every tab currently open on the same site&lt;/p&gt;</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" /></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">sessionstorage_a3</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="iaf42453079cbc49bdb218afdf6b3f596" title="State model"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>state-model_a1,state-model_a2,state-model_a3,state-model_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;In UI development, state is best described as:&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="state-model_a1"><material><mattext texttype="text/html">&lt;p&gt;The DOM tree as the browser has currently rendered it&lt;/p&gt;</mattext></material></response_label><response_label ident="state-model_a2"><material><mattext texttype="text/html">&lt;p&gt;The set of CSS classes applied to the page&lt;/p&gt;</mattext></material></response_label><response_label ident="state-model_a3"><material><mattext texttype="text/html">&lt;p&gt;The user&amp;#x27;s saved preferences, and nothing else&lt;/p&gt;</mattext></material></response_label><response_label ident="state-model_a4"><material><mattext texttype="text/html">&lt;p&gt;The current data that determines what the interface shows&lt;/p&gt;</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" /></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">state-model_a4</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="idb8ae20d11cf7bd0cd4fee2e5a4a403d" title="Serialization"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>serialization_a1,serialization_a2,serialization_a3,serialization_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A developer wants to save the object below in &lt;code&gt;localStorage&lt;/code&gt;:&lt;/p&gt;&lt;pre&gt;&lt;code&gt;const prefs = { theme: 'dark', compact: true }
localStorage.setItem('prefs', ???)&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;What should replace &lt;code&gt;???&lt;/code&gt;?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="serialization_a1"><material><mattext texttype="text/html">&lt;p&gt;JSON.stringify(prefs)&lt;/p&gt;</mattext></material></response_label><response_label ident="serialization_a2"><material><mattext texttype="text/html">&lt;p&gt;JSON.parse(prefs)&lt;/p&gt;</mattext></material></response_label><response_label ident="serialization_a3"><material><mattext texttype="text/html">&lt;p&gt;Object.entries(prefs)&lt;/p&gt;</mattext></material></response_label><response_label ident="serialization_a4"><material><mattext texttype="text/html">&lt;p&gt;prefs.toString()&lt;/p&gt;</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" /></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">serialization_a1</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="i8df09a4ea16d578b02d793ab23ea3944" title="boolean-string-gotcha"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>boolean-string-gotcha_a1,boolean-string-gotcha_a2,boolean-string-gotcha_a3,boolean-string-gotcha_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A developer stores &lt;code&gt;localStorage.setItem('active', false)&lt;/code&gt; and later reads &lt;code&gt;if (localStorage.getItem('active'))&lt;/code&gt;. What happens?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="boolean-string-gotcha_a1"><material><mattext texttype="text/html">&lt;p&gt;getItem returns null, because false is treated as empty&lt;/p&gt;</mattext></material></response_label><response_label ident="boolean-string-gotcha_a2"><material><mattext texttype="text/html">&lt;p&gt;The condition is true, because &amp;#x27;false&amp;#x27; is a non-empty string&lt;/p&gt;</mattext></material></response_label><response_label ident="boolean-string-gotcha_a3"><material><mattext texttype="text/html">&lt;p&gt;The condition is false, because the boolean was preserved&lt;/p&gt;</mattext></material></response_label><response_label ident="boolean-string-gotcha_a4"><material><mattext texttype="text/html">&lt;p&gt;A TypeError is thrown, because booleans cannot be stored&lt;/p&gt;</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" /></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">boolean-string-gotcha_a2</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="i5a268560ff03c530e09926303544ea9a" title="storage-persistence"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>storage-persistence_a1,storage-persistence_a2,storage-persistence_a3,storage-persistence_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A user closes the browser tab and reopens the same site. Which storage still contains data they saved?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="storage-persistence_a1"><material><mattext texttype="text/html">&lt;p&gt;Neither — both are cleared when the tab closes&lt;/p&gt;</mattext></material></response_label><response_label ident="storage-persistence_a2"><material><mattext texttype="text/html">&lt;p&gt;Both — their persistence behaviour is identical&lt;/p&gt;</mattext></material></response_label><response_label ident="storage-persistence_a3"><material><mattext texttype="text/html">&lt;p&gt;localStorage, which persists until it is explicitly cleared&lt;/p&gt;</mattext></material></response_label><response_label ident="storage-persistence_a4"><material><mattext texttype="text/html">&lt;p&gt;sessionStorage, which persists across browser restarts&lt;/p&gt;</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" /></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">storage-persistence_a3</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item></section></assessment></questestinterop>