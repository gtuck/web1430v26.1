e</fieldlabel><fieldentry>cc.multiple_choice.v0p1</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A child Vue component needs to tell its parent that a button was clicked. Which pattern should the component use?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="vue-props-direction_a1"><material><mattext texttype="text/html">&lt;p&gt;Modify the prop it received from the parent&lt;/p&gt;</mattext></material></response_label><response_label ident="vue-props-direction_a2"><material><mattext texttype="text/html">&lt;p&gt;Write the change to localStorage for the parent to read&lt;/p&gt;</mattext></material></response_label><response_label ident="vue-props-direction_a3"><material><mattext texttype="text/html">&lt;p&gt;Call into the parent with document.querySelector&lt;/p&gt;</mattext></material></response_label><response_label ident="vue-props-direction_a4"><material><mattext texttype="text/html">&lt;p&gt;Emit a custom event so the parent can act on it&lt;/p&gt;</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" /></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">vue-props-direction_a4</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="ib8082c79025fb3fbaaec27cb130a94d4" title="gitignore-purpose"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>cc_profile</fieldlabel><fieldentry>cc.multiple_choice.v0p1</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Which files should be listed in a &lt;code&gt;.gitignore&lt;/code&gt; for a Vite/Node.js project, and why?&lt;/p&gt;</mattext></material><response_lid ident="response1